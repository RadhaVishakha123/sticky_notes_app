# ─── Docker Compose environment ──────────────────────────────
# Copy this file to docker/.env before running docker compose

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stickynotes
POSTGRES_PORT=5432

# Backend API
API_PORT=3000
NODE_ENV=production

# Auth — REQUIRED: generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret

# CORS — allow the Expo dev server (running outside Docker)
CORS_ORIGINS=http://localhost:8081

# MinIO (object storage for note images)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
