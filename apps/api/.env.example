# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stickynotes?schema=public"

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth ────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET="change-this-to-a-long-random-secret-before-production"
JWT_EXPIRES_IN="7d"

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:8081,exp://localhost:8081"

# ─── Email (Gmail SMTP via Nodemailer) ───────────────────────
# Use a Google App Password (NOT your regular Gmail password)
# Generate one at: myaccount.google.com/apppasswords (requires 2FA)
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
FROM_EMAIL="your-gmail@gmail.com"

# MinIO (object storage for note images)
# Use http://your-server-ip:9000 in production
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=notes-images
MINIO_PUBLIC_URL=http://localhost:9000
